# WHMCS MCP Server (Golang Edition) Configuration
# Salin berkas ini ke .env dan sesuaikan nilai konfigurasi Anda

# ===========================================
# WAJIB: URL Instalasi WHMCS
# ===========================================
# URL instalasi WHMCS Anda (mendukung HTTP atau HTTPS)
# Contoh: https://billing.example.com
WHMCS_URL=https://billing.example.com

# ===========================================
# WAJIB: Kredensial API WHMCS
# ===========================================
# Dibuat pada WHMCS Admin: Setup > Staff Management > API Credentials (atau API Roles)
WHMCS_API_IDENTIFIER=your-api-identifier-here
WHMCS_API_SECRET=your-api-secret-here

# ===========================================
# OPSIONAL: Keamanan & Parameter Lanjutan
# ===========================================
# API Access Key (jika dikonfigurasi di configuration.php: $api_access_key)
WHMCS_API_ACCESS_KEY=

# HTTP Basic Authentication (Opsional: jika web server Nginx/Apache/Cloudflare dilindungi htpasswd)
# Catatan: Bisa juga disematkan langsung di WHMCS_URL (contoh: https://user:pass@domain.com)
WHMCS_HTTP_USERNAME=
WHMCS_HTTP_PASSWORD=

# Batas waktu timeout pemanggilan HTTP ke WHMCS (default: 30s)
WHMCS_TIMEOUT=30s

# Mode diagnostik / debug logging ke os.Stderr (true / false)
WHMCS_DEBUG=false
